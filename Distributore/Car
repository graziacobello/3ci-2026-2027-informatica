public class Car{
    private final double kmPerLitro=20;
    private final double capienzaSerbatoio=100;
    private double benzinaDisponibile;
    public Car(){
        this.benzinaDisponibile=0.0;
    }
    public void setBenzinaDisponibile(double bD){
        if (bD>=0){
            this.benzinaDisponibile=bD;
        }
    }
    public double getBenzinaDisponibile(){
        return this.benzinaDisponibile;
    }
    public String toString(){
        String out="";
        out+="Questa auto percorre km: "+kmPerLitro +"con un litro di benzina \n";
        out+="il suo serbatoio può contenere al massimo "+capienzaSerbatoio +"litri di benzina \n";
        out+="e in questo momento il serbatoio contiene "+ benzinaDisponibile + "litri di benzina";
        return out;
        
    }
}